# Copy to .env and fill in. Never commit .env.

# REQUIRED: master key that encrypts broker credentials and TOTP secrets at rest.
# Generate with:  python run.py genkey
# Keep a safe offline copy: without it the stored credentials cannot be decrypted.
ALGO_MASTER_KEY=

# Bind address. Keep 127.0.0.1 unless you put an HTTPS reverse proxy in front (see README).
ALGO_HOST=127.0.0.1
ALGO_PORT=8000

# Database: SQLite by default (data/algo.db). For PostgreSQL:
# ALGO_DATABASE_URL=postgresql+psycopg://algo:password@localhost:5432/algo
ALGO_DATABASE_URL=

# Where the database, logs and instrument cache live.
ALGO_DATA_DIR=./data

# Session cookie Secure flag: auto (Secure when the request is HTTPS), true, or false.
ALGO_COOKIE_SECURE=auto
# Log out after this many idle minutes, and after this many hours regardless.
ALGO_SESSION_IDLE_MINUTES=30
ALGO_SESSION_MAX_HOURS=12
# Set true only when running behind your own reverse proxy that sets X-Forwarded-For/Proto.
ALGO_TRUST_PROXY_HEADERS=false
